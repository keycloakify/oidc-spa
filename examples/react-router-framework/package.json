        "@upstash/redis": "1.39.0",
        "isbot": "5.2.2",
        "oidc-spa": "11.0.0-rc.7",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-router": "8.5.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@react-router/dev": "8.5.0",
        "@types/node": "24.10.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.7",
        "typescript": "5.9.3",
        "vite": "8.2.2"
    },
    "engines": {
        "node": ">=22.22.0"
    }
}
