{
    "name": "example-react-router-data",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently --kill-others \"vite\" \"tsx watch server/index.ts --api-only\"",
        "typecheck": "tsc --noEmit",
        "build": "vite build && tsc --noEmit && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.mjs",
        "start": "node dist/server/index.mjs"
    },
    "dependencies": {
        "@trpc/client": "11.18.0",
        "@trpc/server": "11.18.0",
        "@upstash/redis": "1.39.0",
        "dotenv": "18.0.9",
        "express": "5.3.0",
        "oidc-spa": "11.0.0-rc.7",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "zod": "4.6.7",
        "react-router": "8.5.0"
    },
    "devDependencies": {
        "@types/express": "5.0.6",
        "@types/node": "24.10.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.7",
        "@vitejs/plugin-react": "6.1.2",
        "concurrently": "10.0.6",
        "esbuild": "0.28.2",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "vite": "8.2.2"
    },
    "engines": {
        "node": ">=22.22.0"
    }
}
