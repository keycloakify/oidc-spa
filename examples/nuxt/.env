# Copy to .env for local development. Production reads NUXT_* environment variables.

# Uncomment the provider you want to test with.
NUXT_PUBLIC_OIDC_PROVIDER=Keycloak
#NUXT_PUBLIC_OIDC_PROVIDER=Keycloak2
#NUXT_PUBLIC_OIDC_PROVIDER=Auth0
#NUXT_PUBLIC_OIDC_PROVIDER=EntraID
#NUXT_PUBLIC_OIDC_PROVIDER=mock

# === Keycloak - Offline Token Validation ===
NUXT_PUBLIC_KEYCLOAK_ISSUER_URI=https://phasetwo.oidc-spa.dev/realms/demo-realm
NUXT_PUBLIC_KEYCLOAK_CLIENT_ID=myapp
NUXT_KEYCLOAK_EXPECTED_ACCESS_TOKEN_AUDIENCE=myapp-api

# === Keycloak - Calling Token Introspection ===
NUXT_PUBLIC_KEYCLOAK2_ISSUER_URI=https://phasetwo.oidc-spa.dev/realms/demo-realm
NUXT_PUBLIC_KEYCLOAK2_CLIENT_ID=myapp
NUXT_KEYCLOAK2_API_CLIENT_ID=myapp-api
NUXT_KEYCLOAK2_API_CLIENT_SECRET=BpFyRH3fGwD6ND9QGtqktjAqDR6U99uY

# === Auth0 ===
# Run the dev server on app.localhost to avoid repeated consent prompts. See nuxt.config.ts
NUXT_PUBLIC_AUTH0_ISSUER_URI=https://auth0.oidc-spa.dev
NUXT_PUBLIC_AUTH0_CLIENT_ID=0o0taUvgGj3RvUGhI5tjdhwgqmgdsPVx
NUXT_PUBLIC_AUTH0_API_IDENTIFIER=https://oidc-spa-example
NUXT_PUBLIC_AUTH0_SSO_SESSION_IDLE_SECONDS=1800

# === Microsoft Entra ID ===
NUXT_PUBLIC_ENTRA_ISSUER_URI=https://login.microsoftonline.com/56bd3db6-db83-4be4-b972-44009528ca1c/v2.0
NUXT_PUBLIC_ENTRA_CLIENT_ID=7f1d2c0c-7091-46ce-9e83-39daeb4655a6
NUXT_PUBLIC_ENTRA_API_SCOPE=api://my-app-api/access_as_user
NUXT_ENTRA_API_CLIENT_ID=13836c51-1024-4b3c-b504-8af2ad08af58

# =======================================
# Optional: Upstash Redis (persistent todos)
# =======================================
# Vercel’s filesystem is read-only, so we use a hosted KV store.
# See: https://upstash.com/
#
#NUXT_KV_REST_API_URL=
#NUXT_KV_REST_API_TOKEN=
