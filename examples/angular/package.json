{
  "name": "angular-new",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "concurrently --kill-others \"ng serve --host app.localhost --port 3000\" \"tsx watch server/index.ts --api-only\"",
    "start": "node dist/angular-new/server/index.mjs",
    "build": "ng build && tsc --project tsconfig.server.json && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/angular-new/server/index.mjs",
    "typecheck": "ngc --noEmit --project tsconfig.app.json && tsc --project tsconfig.server.json",
    "format:check": "prettier --check src server/*.ts *.json *.cjs README.md",
    "postinstall": "node -e \"const fs = require('node:fs'); if (!fs.existsSync('.env')) fs.copyFileSync('.env.sample', '.env');\""
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@upstash/redis": "1.39.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "oidc-spa": "11.0.0-rc.7",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@types/express": "5.0.6",
    "@types/node": "24.10.0",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "tsx": "4.23.15"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
