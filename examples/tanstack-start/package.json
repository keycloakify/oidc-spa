        "react": "19.3.1",
        "react-dom": "19.3.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/node": "22.20.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "nitro": "3.0.260903-beta",
        "@typescript/native": "npm:typescript@7.0.2",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "vite": "8.3.5",
        "wrangler": "4.166.0"
    }
