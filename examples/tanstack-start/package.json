{
    "name": "tanstack-start-next",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "npm run build:vercel && npm run build:cloudflare && npm run build:netlify && npm run build:self-hosted",
