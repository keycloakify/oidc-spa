        "build:cloudflare": "NITRO_PRESET=cloudflare-module vite build && tsc --noEmit",
        "build:netlify": "NITRO_PRESET=netlify vite build && tsc --noEmit",
        "build:self-hosted": "NITRO_PRESET=node-server vite build && tsc --noEmit",
        "preview": "vite preview"
    },
    "dependencies": {
        "oidc-spa": "next",
        "@tanstack/react-router": "1.170.46",
        "@tanstack/react-start": "1.169.4",
