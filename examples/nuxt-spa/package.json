{
    "name": "nuxt-spa",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "prepare": "node scripts/setup-env.mjs",
        "build": "nuxt build --dotenv .env.local",
        "dev": "nuxt dev --dotenv .env.local",
        "generate": "nuxt generate --dotenv .env.local",
        "preview": "nuxt preview --dotenv .env.local",
        "postinstall": "nuxt prepare",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "nuxt typecheck --dotenv .env.local"
    },
    "dependencies": {
        "@iconify-json/lucide": "1.2.129",
        "@nuxt/ui": "4.11.1",
        "nuxt": "4.5.2",
        "tailwindcss": "4.3.3",
        "vue": "3.5.42",
        "vue-router": "5.3.1",
        "oidc-spa": "latest",
        "zod": "4.5.4"
    },
    "devDependencies": {
        "@nuxt/eslint": "1.17.0",
        "eslint": "10.10.0",
        "typescript": "6.0.3",
        "vue-tsc": "3.3.11"
    },
    "engines": {
        "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
    }
}
